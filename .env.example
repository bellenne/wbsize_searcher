TARGET_URL=https://example.org
SEARCH_TEXT=Example Domain
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
EXTRA_WAIT_MS=3000
OUTPUT_DIR=/app/output
LOG_LEVEL=INFO
SCREENSHOT_FULL_PAGE=true
SAVE_HTML=true
SAVE_TEXT=true
SAVE_NETWORK_LOG=true
SAVE_CONSOLE_LOG=true
SAVE_ERROR_LOG=true
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
API_HOST=0.0.0.0
API_PORT=8000
ARTIFACT_PUBLIC_BASE_URL=https://example.com/storage/browser-worker
AUTH_ENABLED=false
AUTH_PHONE=79990000000
AUTH_PHONE_SELECTOR=input[name="phone"]
AUTH_PHONE_SUBMIT_SELECTOR=button[type="submit"]
AUTH_CODE=
AUTH_CODE_FILE=/app/output/auth_code.txt
AUTH_CODE_SELECTOR=input[name="code"]
AUTH_CODE_SUBMIT_SELECTOR=button[type="submit"]
AUTH_CODE_TIMEOUT_MS=180000
AUTH_CODE_POLL_INTERVAL_MS=1000
AUTH_WAIT_AFTER_PHONE_SUBMIT_MS=3000
AUTH_WAIT_AFTER_CODE_SUBMIT_MS=5000
AUTH_INTERACTIVE_CODE_ENTRY=true
POST_AUTH_WAIT_FOR_NETWORKIDLE=true
POST_AUTH_EXTRA_WAIT_MS=5000
TARGET_BUTTON_DIV_TEXT=Продолжить
TARGET_BUTTON_TIMEOUT_MS=60000
CLICK_TARGET_BUTTON=false
TARGET_BUTTON_CLICK_WAIT_MS=3000
KEEP_SESSION_ALIVE=true
KEEP_ALIVE_LOG_INTERVAL_MS=30000
