# Стартовая страница worker-а. Для WB обычно это страница авторизации.
TARGET_URL=https://example.org
# Уникальный id worker-а. В multi-compose переопределяется для каждого контейнера.
WORKER_ID=worker-1
SEARCH_TEXT=Example Domain
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
EXTRA_WAIT_MS=2000
# Папка артефактов: скриншоты, html, логи, trace.
OUTPUT_DIR=/app/output
# Постоянный профиль Chromium внутри контейнера. Для каждого worker-а должен быть свой volume.
BROWSER_PROFILE_DIR=/app/browser-profile
LOG_LEVEL=INFO
SCREENSHOT_FULL_PAGE=true
SAVE_HTML=true
SAVE_TEXT=true
SAVE_NETWORK_LOG=true
SAVE_CONSOLE_LOG=true
SAVE_ERROR_LOG=true
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
API_HOST=0.0.0.0
API_PORT=8000
ARTIFACT_PUBLIC_BASE_URL=https://example.com/storage/browser-worker
# Автоматически запускать браузерную сессию при старте worker-а.
AUTO_START_SESSION=true
# Куда перейти при автозапуске. Если пусто, используется WORKSPACE_URL.
AUTO_START_TARGET_URL=https://seller.wildberries.ru/marketplace-orders-fbs/new-tasks
# Включает ожидание авторизации в статусах worker-а.
AUTH_ENABLED=false
# Телефон по умолчанию, если старый endpoint вызван без phone.
AUTH_PHONE=79990000000
# Упрощенная авторизация: worker вставляет phone в это поле и нажимает Enter.
AUTH_PHONE_SELECTOR=input[placeholder="999 999-99-99"]
# Если пусто, worker нажимает Enter в поле телефона.
AUTH_PHONE_SUBMIT_SELECTOR=
AUTH_CODE=
AUTH_CODE_FILE=/app/output/auth_code.txt
# Упрощенный ввод SMS-кода: worker вставляет code в это поле и нажимает Enter.
AUTH_CODE_SELECTOR=input[data-testid="sms-code-input"]
# Если пусто, worker нажимает Enter в поле кода.
AUTH_CODE_SUBMIT_SELECTOR=
AUTH_CODE_TIMEOUT_MS=180000
AUTH_CODE_POLL_INTERVAL_MS=1000
AUTH_WAIT_AFTER_PHONE_SUBMIT_MS=3000
AUTH_WAIT_AFTER_CODE_SUBMIT_MS=5000
# Если браузер находится на этом URL или внутри этого префикса, worker считается авторизованным.
AUTHORIZED_URL_PREFIX=https://seller.wildberries.ru/marketplace-orders-fbs/new-tasks
# Если браузер находится на этом URL или внутри этого префикса, worker считается неавторизованным.
AUTH_REQUIRED_URL_PREFIX=https://seller-auth.wildberries.ru/ru/
AUTH_INTERACTIVE_CODE_ENTRY=true
POST_AUTH_WAIT_FOR_NETWORKIDLE=false
POST_AUTH_EXTRA_WAIT_MS=5000
TARGET_BUTTON_DIV_TEXT=Продолжить
TARGET_BUTTON_TIMEOUT_MS=60000
CLICK_TARGET_BUTTON=false
TARGET_BUTTON_CLICK_WAIT_MS=3000
KEEP_SESSION_ALIVE=true
KEEP_ALIVE_LOG_INTERVAL_MS=30000

# Опциональный JSON-конфиг сценариев. Env ниже используется как дефолт без файла.
SCENARIO_CONFIG_FILE=
# Рабочая страница, на которую worker переходит при force_refresh=true.
WORKSPACE_URL=https://example.org
# Упрощенное закрытие модалки: balancer сам формирует старый /actions/click payload.
CLOSE_MODAL_SELECTOR="#Portal-drawer [data-name='Overlay'] button[type='button']"
CLOSE_MODAL_ACTION_NAME=close pvz modal first button
CLOSE_MODAL_DIV_TEXT=
CLOSE_MODAL_CLICK_WAIT_MS=3000
CLOSE_MODAL_EXTRA_WAIT_MS=3000
# Упрощенная смена кабинета: входной payload содержит "in" и "out".
CABINET_PROFILE_SELECTOR=.ProfileView
CABINET_HOVER_WAIT_MS=500
CABINET_POST_CLICK_WAIT_MS=3000
# Поиск размера выполняется только по номеру заказа. Эти значения повторяют старую логику extract_size_by_code.
SEARCH_ROW_SELECTOR=[data-testid='Table-row-view']
SEARCH_VALUE_CELL_SELECTOR=[data-testid='Cell--title']
SEARCH_SIZE_REGEX=Р\s*-\s*р[\s\xa0]+([^\n\r]+)

# Настройки balancer-а для docker-compose.multi.yml.
# WORKERS - список внутренних Docker URL. Снаружи эти адреса не открываются, ими пользуется balancer.
WORKERS=browser-worker-1=http://browser-worker-1:8000,browser-worker-2=http://browser-worker-2:8000,browser-worker-3=http://browser-worker-3:8000,browser-worker-4=http://browser-worker-4:8000,browser-worker-5=http://browser-worker-5:8000
# Максимум попыток выполнения одной задачи поиска размера.
TASK_MAX_ATTEMPTS=2
# Timeout HTTP-запроса balancer-а к worker-у на одну попытку.
TASK_TIMEOUT_SECONDS=180
# Максимум попыток доставки callback в Laravel.
CALLBACK_MAX_ATTEMPTS=5
# Timeout одного callback-запроса.
CALLBACK_TIMEOUT_SECONDS=15
# Через сколько секунд balancer снова отправит worker-у force_refresh=true.
WORKER_REFRESH_TTL_SECONDS=300
# Как часто balancer опрашивает /status worker-ов.
WORKER_STATUS_POLL_INTERVAL_SECONDS=5
# Папка SQLite-базы balancer-а.
BALANCER_DATA_DIR=/app/balancer-data
# Токен callback по умолчанию, если задача пришла без callback_token.
DEFAULT_CALLBACK_TOKEN=
# Если true, balancer после рестарта снова поставит старые queued/running/retrying задачи в очередь.
# По умолчанию false, чтобы не слать callback по старым задачам после перезапуска.
REQUEUE_UNFINISHED_ON_STARTUP=false
